PORT=4000
CLIENT_URL=http://localhost:5173

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://folio:folio@localhost:5432/folio
# Set to true for hosted databases that require SSL
DATABASE_SSL=false

# Any long random string
JWT_SECRET=change-me

# Python scraper service (see /scraper)
SCRAPER_URL=http://localhost:8000

# Optional: enables AI summaries (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# How often to refresh the RSS feeds
SYNC_INTERVAL_MINUTES=30
